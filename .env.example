# Copy this file to .env on RunPod. Never commit the real .env file.
HF_TOKEN=
HF_MODEL_REPO=your-huggingface-name/hinglish-turn-8m

WANDB_API_KEY=
WANDB_ENABLED=true
WANDB_ENTITY=
WANDB_PROJECT=hinglish-turn-detector
WANDB_RUN_NAME=
WANDB_RUN_ID=
WANDB_MODE=online

# Point these at persistent RunPod storage, not the container's ephemeral disk.
HF_HOME=/workspace/cache/huggingface
WANDB_DIR=/workspace/artifacts/wandb
