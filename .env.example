# Copy this file to .env on RunPod. Never commit the real .env file.
HF_TOKEN=
HF_MODEL_REPO=your-huggingface-name/hinglish-turn-8m
HINGLISH_TURN_MODEL=Mayank022/hinglish-turn-detector-whisper-tiny-dual-scale

WANDB_API_KEY=
WANDB_ENABLED=true
WANDB_PROJECT=hinglish-turn-detector
WANDB_MODE=online

# Optional: uncomment only with a real, non-empty value. Empty WANDB_RUN_ID is invalid.
# WANDB_ENTITY=your-user-or-team
# WANDB_RUN_NAME=custom-run-name
# WANDB_RUN_ID=existing-run-id

# Point these at persistent RunPod storage, not the container's ephemeral disk.
HF_HOME=/workspace/cache/huggingface
WANDB_DIR=/workspace/artifacts/wandb
